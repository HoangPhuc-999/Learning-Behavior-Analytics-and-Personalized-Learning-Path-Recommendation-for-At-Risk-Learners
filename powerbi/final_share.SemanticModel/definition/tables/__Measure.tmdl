table __Measure
	lineageTag: d18d993e-e8fa-4e84-85d0-ed3778a537dd

	measure 'Total Enrollments' = COUNTROWS(features_final)
		formatString: 0.00
		lineageTag: 8dbbba15-0438-4786-907c-291bed47b46d

	measure 'Unique Learners' = DISTINCTCOUNT(features_final[id_student])
		formatString: 0.00
		lineageTag: 9d56951a-6faf-480f-8e26-d7e4c43b01b9

	measure 'At-Risk Learners' =
			
			CALCULATE(
			    COUNTROWS(features_final),
			    features_final[at_risk] = 1
			)
		formatString: 0
		lineageTag: 418f955d-5498-4347-b538-dac08df095cc

	measure 'At-Risk Rate' = DIVIDE([At-Risk Learners], [Total Enrollments])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 53409a79-02bd-471c-9db5-aec8b24c7bd6

	measure 'Median Early Engagement' = MEDIAN(features_final[early_engagement])
		lineageTag: ddd212f3-f6c4-4fc8-91f3-b87f6a6d7483

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Score' = AVERAGE(features_final[avg_score])
		formatString: 0.0
		lineageTag: c531a277-9729-4904-9a6e-d5fc4d7f2646

	measure 'Avg Completion Ratio' = AVERAGE(features_final[completion_ratio])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 007bd4a1-d14f-4531-a054-17bb63b9e661

	measure 'Avg Submission Delay' = AVERAGE(features_final[avg_submission_delay])
		lineageTag: c6a461a1-674f-40f3-9e44-86f8634b8610

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Days Since Last Activity' = AVERAGE(features_final[days_since_last])
		lineageTag: fd2c098f-226e-46a7-9bb7-ddd6e4e1b21d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Segment Enrollments' =
			
			COUNTROWS(segment_assignments)
		formatString: 0
		lineageTag: da6fcc09-a4a9-4450-93df-6d5a75fd0a5d

	measure 'Segment At-Risk Learners' =
			
			CALCULATE(
			    COUNTROWS(segment_assignments),
			    segment_assignments[at_risk] = 1
			)
		formatString: 0
		lineageTag: 994dd6ad-2d91-4b61-98b3-c51ad06af2db

	measure 'Segment At-Risk Rate' =
			
			DIVIDE([Segment At-Risk Learners], [Segment Enrollments])
		lineageTag: 964f6d54-d8f2-4e4f-9fd6-4560d1cb65a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recommendation Count' =
			
			COUNTROWS(personalized_learning_paths)
		formatString: 0
		lineageTag: 96064d64-d1b1-4946-b432-196f9ae0db6c

	measure 'Avg Recommendation Score' =
			
			AVERAGE(personalized_learning_paths[recommendation_score])
		lineageTag: 1cac78e6-2bc3-4b4f-af9c-06e9afab1cae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion Precision' =
			
			CALCULATE(
			    MAX(champion_test_metrics[precision]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 59bcdf09-21e0-4b25-bb8a-458ff0d3b20c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion Recall' =
			
			CALCULATE(
			    MAX(champion_test_metrics[recall]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 0e8b47e9-1a47-4d80-b0e8-999d28be0463

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion F2' =
			
			CALCULATE(
			    MAX(champion_test_metrics[f2]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 33263c6b-a361-40d1-be95-5d144b50cb5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion ROC AUC' =
			
			CALCULATE(
			    MAX(champion_test_metrics[roc_auc]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 7db2d760-2d21-40fa-a71f-087e9935149f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion PR AUC' =
			
			CALCULATE(
			    MAX(champion_test_metrics[pr_auc]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 1c55234c-ef0e-4706-9a2f-6c281c3d480d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion Brier Score' =
			
			CALCULATE(
			    MAX(champion_test_metrics[brier_score]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 724aa19e-8e50-431a-a735-3770bbdd7f79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion Threshold' =
			
			CALCULATE(
			    MAX(champion_test_metrics[threshold]),
			    champion_test_metrics[split] = "test"
			)
		lineageTag: 7804a9fa-224d-47ab-9f0f-2775f5bb895f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Champion Model Label' =
			
			VAR ModelName =
			    CALCULATE(
			        MAX(champion_test_metrics[model]),
			        champion_test_metrics[split] = "test"
			    )
			VAR HorizonDay =
			    CALCULATE(
			        MAX(champion_test_metrics[horizon_day]),
			        champion_test_metrics[split] = "test"
			    )
			RETURN
			    ModelName & " @ Day " & FORMAT(HorizonDay, "0")
		lineageTag: dc681103-9273-4fc9-b165-1dc1cb6a60c3

	measure 'Risk Band Learners' =
			
			SUM(risk_band_summary[n])
		formatString: 0
		lineageTag: 32b1052b-e037-4935-83d0-318ba5637a10

	measure 'Critical Risk Learners' =
			
			CALCULATE(
			    COUNTROWS(champion_test_predictions),
			    champion_test_predictions[risk_band] = "Critical"
			)
		formatString: 0.00
		lineageTag: 783208fb-54ad-48c9-8629-01bab3449250

	measure 'Predicted Positive Learners' =
			
			CALCULATE(
			    COUNTROWS(champion_test_predictions),
			    champion_test_predictions[y_pred] = 1
			)
		formatString: 0.00
		lineageTag: c7f52b92-380b-4004-8331-362af137bee2

	measure 'Avg Risk Probability' =
			
			AVERAGE(champion_test_predictions[risk_probability])
		lineageTag: 9508afe8-4ecc-4ce9-aa78-b562db167700

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Risk Probability Among Flagged' =
			
			CALCULATE(
			    AVERAGE(champion_test_predictions[risk_probability]),
			    champion_test_predictions[y_pred] = 1
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d94988a6-6361-4be6-a55a-3702b4dfdcff

	measure 'Critical Band Actual At-Risk Rate' =
			
			CALCULATE(
			    MAX(risk_band_summary[actual_at_risk_rate]),
			    risk_band_summary[risk_band] = "Critical"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 078237c3-ce2f-4765-8d0d-e86d039f0a58

	measure 'False Positives' =
			
			CALCULATE(
			    COUNTROWS(champion_test_predictions),
			    champion_test_predictions[prediction_outcome] = "False Positive"
			)
		formatString: 0
		lineageTag: e7eb09af-d2b5-4d70-a9c8-36e2f5a1d54b

	measure 'False Negatives' =
			
			CALCULATE(
			    COUNTROWS(champion_test_predictions),
			    champion_test_predictions[prediction_outcome] = "False Negative"
			)
		formatString: 0
		lineageTag: 2c9529e9-52e2-4c7f-9510-0af06b4023da

	measure 'Most Common Recommendation Path Among Flagged' =
			
			VAR T =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FILTER(
			                champion_test_predictions,
			                champion_test_predictions[y_pred] = 1
			            ),
			            champion_test_predictions[recommended_path],
			            "Learners", COUNTROWS(champion_test_predictions)
			        ),
			        [Learners],
			        DESC
			    )
			RETURN
			    CONCATENATEX(T, champion_test_predictions[recommended_path], "")
		lineageTag: 63c4845e-9ad2-4bfc-80ad-c3c6a547318b

	measure 'Recall CI Lower' =
			
			CALCULATE(
			    MAX(champion_metric_bootstrap_ci[ci_95_lower]),
			    champion_metric_bootstrap_ci[metric] = "recall"
			)
		lineageTag: 4c7f9ba6-5104-4bb2-921f-186daa7420d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recall CI Upper' =
			
			CALCULATE(
			    MAX(champion_metric_bootstrap_ci[ci_95_upper]),
			    champion_metric_bootstrap_ci[metric] = "recall"
			)
		lineageTag: 58af266b-a0ac-499d-8e51-f1ab0b9cb2fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PR AUC CI Lower' =
			
			CALCULATE(
			    MAX(champion_metric_bootstrap_ci[ci_95_lower]),
			    champion_metric_bootstrap_ci[metric] = "pr_auc"
			)
		lineageTag: 88205a57-e738-47b5-8a90-302d87a86553

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PR AUC CI Upper' =
			
			CALCULATE(
			    MAX(champion_metric_bootstrap_ci[ci_95_upper]),
			    champion_metric_bootstrap_ci[metric] = "pr_auc"
			)
		lineageTag: d39cc953-ba7d-4f09-9cba-9f0a644fa199

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Review Load per 1000' =
			
			CALCULATE(
			    MAX(threshold_cost_benefit[expected_review_load_per_1000]),
			    threshold_cost_benefit[selected_operating_point] = TRUE()
			)
		lineageTag: e4685e7d-e9bd-4822-b5e8-d0d1ab66ff90

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected False Alert Ratio' =
			
			CALCULATE(
			    MAX(threshold_cost_benefit[false_alert_ratio]),
			    threshold_cost_benefit[selected_operating_point] = TRUE()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d2f7d240-bc6a-42d5-8e28-cdcb89fa58a9

	measure 'A/B Eligible Learners' =
			
			COUNTROWS(ab_test_assignment)
		formatString: 0.000
		lineageTag: 17802ded-567a-4f9b-8abd-e6e1fde26f71

	measure 'A/B Control Learners' =
			
			CALCULATE(
			    COUNTROWS(ab_test_assignment),
			    ab_test_assignment[variant] = "control"
			)
		formatString: 0.000
		lineageTag: 5f7d6817-20d8-4328-a2dc-b357e9f02cab

	measure 'A/B Treatment Learners' =
			
			CALCULATE(
			    COUNTROWS(ab_test_assignment),
			    ab_test_assignment[variant] = "treatment"
			)
		formatString: 0.000
		lineageTag: 6e7cfd92-f15c-4ca2-b138-2f4f70c5f2ee

	measure 'A/B SRM P-value' =
			
			MAX(ab_test_srm_check[p_value])
		lineageTag: 840fdd29-de03-4394-9ee1-3e40a4994240

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'A/B Minimum Detectable Effect' =
			
			MAX(ab_test_power_analysis[minimum_detectable_effect])
		lineageTag: 686cba57-3ad8-46c0-b556-17b2e1dcd8a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Earliest Useful Horizon' = "Day 7"
		lineageTag: 0354def5-e4e1-4fa6-8737-717e1fcd2a5b

	measure 'Best Day-7 Recall' = 0.9393
		lineageTag: 01966961-b2ec-4815-bba5-1db8a73a3804

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Best Day-7 PR-AUC' = 0.7592
		lineageTag: 9245d2d4-93a2-43cf-9fa1-b4c6a57393e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Best Day-30 PR-AUC' = 0.8639
		lineageTag: f559cf3d-2da0-436a-87b8-caef6271d0a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Threshold' = 0.25
		lineageTag: 2e08f09c-1682-4924-9437-63df00ec266c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Flagged Learner-Enrollments' =
			
			CALCULATE(
			    DISTINCTCOUNT(champion_test_predictions[EnrollmentKey]),
			    champion_test_predictions[y_pred] = 1
			)
		formatString: 0
		lineageTag: 1d369b88-3629-42f6-9c4a-3d0eff48195c

	measure 'Recall 95% CI' = [Recall CI Upper] - [Recall CI Lower]
		formatString: 0.0000
		lineageTag: 2d3d4bd8-cbd0-49c1-b7a9-f24bb439878e

	measure 'PR AUC 95% CI' = [PR AUC CI Upper] - [PR AUC CI Lower]
		formatString: 0.0000
		lineageTag: b52cbeb2-b114-41e3-8ef5-446400734ef2

	measure 'Earliest Horizon' = "Day 7"
		lineageTag: a99f9a68-6804-4218-9ec6-a7a2822ad1a9

	measure 'Number of Segments' = 4
		formatString: 0
		lineageTag: 64092878-22ca-4bb0-a023-7c6e7a3af3d6

	measure 'Largest Segment' = "Steady Progressors"
		lineageTag: 64181c3c-4e03-4e5f-9586-2fe609f3b1f1

	measure 'Highest-Risk Segment' = "Inactive Drop-offs"
		lineageTag: 07a45cdc-952d-4d3b-87a7-81d8e0c220c6

	measure 'Most Common Path' = "Consistency Building"
		lineageTag: f66a7827-d7c1-4662-a02b-3825760d64a4

	measure 'Risk Signal Mean' =
			
			AVERAGE(risk_signal_trajectory[mean])
		lineageTag: c2f0026a-c783-4711-a8fb-ce91aecd9021

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Risk Signal Normalized' =
			
			VAR CurrentValue = [Risk Signal Mean]
			VAR MinValue =
			    CALCULATE(
			        MIN(risk_signal_trajectory[mean]),
			        REMOVEFILTERS(DimHorizon),
			        REMOVEFILTERS(risk_signal_trajectory[horizon_day]),
			        REMOVEFILTERS(risk_signal_trajectory[group])
			    )
			VAR MaxValue =
			    CALCULATE(
			        MAX(risk_signal_trajectory[mean]),
			        REMOVEFILTERS(DimHorizon),
			        REMOVEFILTERS(risk_signal_trajectory[horizon_day]),
			        REMOVEFILTERS(risk_signal_trajectory[group])
			    )
			RETURN
			    DIVIDE(CurrentValue - MinValue, MaxValue - MinValue)
		lineageTag: 8bdd7e56-de5f-4eb8-9ddf-90989d325207

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Learner 360 Title' =
			
			"Student "
			    & SELECTEDVALUE(champion_test_predictions[id_student], "Unknown")
			    & " | "
			    & SELECTEDVALUE(champion_test_predictions[code_module], "Module")
			    & " | "
			    & SELECTEDVALUE(champion_test_predictions[code_presentation], "Presentation")
		lineageTag: aeb3f957-85b5-4bcf-8e0a-a54974af530e

	measure 'Selected Risk Probability' =
			
			MAX(champion_test_predictions[risk_probability])
		lineageTag: 09a1f57f-61ef-44f9-bc50-61cd80833fce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Risk Band' =
			
			SELECTEDVALUE(champion_test_predictions[risk_band], "No selected learner")
		lineageTag: b033ace9-618e-40e7-ac1c-c23e8607270f

	measure 'Selected Segment' =
			
			SELECTEDVALUE(champion_test_predictions[cluster_label], "No selected learner")
		lineageTag: 563b1e06-0ad8-482a-abcc-71e298bd165b

	measure 'Selected Recommended Path' =
			
			SELECTEDVALUE(champion_test_predictions[recommended_path], "No selected learner")
		lineageTag: 982adb98-7412-491a-b114-60c8dd47a771

	measure 'Selected Prediction Outcome' =
			
			SELECTEDVALUE(champion_test_predictions[prediction_outcome], "No selected learner")
		lineageTag: 15ebb74b-2775-4da1-8f98-ae13586ed694

	measure 'Selected Action 1' = SELECTEDVALUE(champion_test_predictions[action_1], "No action available")
		lineageTag: e6d29483-e52c-43c4-bd0f-454e52810545

	measure 'Selected Action 2' = SELECTEDVALUE(champion_test_predictions[action_2], "No action available")
		lineageTag: ae2c1bd5-c72e-43d4-8e75-d75e31537a76

	measure 'Selected Action 3' = SELECTEDVALUE(champion_test_predictions[action_3], "No action available")
		lineageTag: 3322b4b8-e74c-4f70-ac7a-fb2780438cc2

	partition __Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

